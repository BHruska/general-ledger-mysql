# .env.dev -- committed; contains nothing secret. Production's equivalent is
# env/general-ledger.env in the infra repo, and has the same keys.
DATABASE_URL=mysql+pymysql://gl:devpass@db:3306/gl
APP_HTTPS=0
TZ=America/Chicago

# Unlocks <ref>.enc credential files. Empty here: dev uses plain files written by
# scripts/dev_init.py. In production this lives in env/general-ledger.env -- a
# DIFFERENT tree from /opt/data/secrets, which is the whole point: an attacker
# needs both (docs/CREDENTIALS.md section 2).
GL_KEYSTORE_PASSPHRASE=

# Worker idle cadence (seconds): how often it checks for requested work.
WORKER_TICK_SECONDS=15
